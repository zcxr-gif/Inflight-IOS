<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The app's privacy manifest.

    Required since May 2024: an app that calls a "required reason" API without
    declaring why is rejected at upload with ITMS-91053, which arrives as an
    email after the upload appears to have succeeded. Every declaration below
    is a fact about this app's code, so each one has to be re-checked when that
    code changes.

    Copied to the root of the .app — the name and the location are both fixed
    by Apple, which is why this lives in a directory of its own rather than
    being prefixed the way the Info.plists are.
-->
<plist version="1.0">
<dict>
	<!-- The tracker has no advertising, no analytics, and no third-party SDK
	     that does either. The only network it speaks to is its own backend. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	    What the app actually collects, now that it has accounts and sells a
	    subscription. This is a list of facts about the code, and it has to
	    agree with the privacy answers on the App Store Connect record — a
	    manifest that disagrees with the questionnaire is the other way an
	    upload comes back.

	    Everything here is App Functionality and everything here is linked to
	    the account, because that is the whole point of having one: the profile
	    is what carries Pro and the watchlist from one device to the next.
	    Nothing is used for tracking, and there is no advertising or analytics
	    SDK in the build to use it with.

	    The APNs device token is deliberately not listed. The backend stores it
	    keyed to the watchlist for as long as the device is registered, and
	    uses it only to deliver notifications the user asked for; whether that
	    counts as collected Device ID is a call for whoever owns the App Store
	    listing, and it is unchanged by anything here.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- The address an account is made with. Sign in with Apple may
			     substitute a private relay address, which the app neither
			     detects nor treats differently. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<dict>
			<!-- Only ever from Sign in with Apple, which offers one on the
			     first authorisation. It is stored so the account has something
			     to be called other than an email address. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<dict>
			<!-- Which Inflight Pro plan is held and when it runs out, linked
			     to the account so the entitlement works on the website as well
			     as on the phone. Apple's own transaction identifiers; no
			     payment details, which the app never sees. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<dict>
			<!-- The account id itself, and the Infinite Flight handle stored
			     against it so the tracker can pick your aircraft out of the
			     traffic. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1 — the app's own defaults: which server is selected,
				     the filters, the weather units, the window's appearance,
				     which hints have been read. -->
				<string>CA92.1</string>
				<!-- 1C8F.1 — the app group's defaults, which is how the app and
				     its widget extension agree on the watchlist, the push
				     registration and the pinned flight. -->
				<string>1C8F.1</string>
			</array>
		</dict>

		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1 — timestamps of files inside the app group
				     container. `SharedStore` reads them to expire the cached
				     aircraft photos the widgets are drawn on. Nothing outside
				     the container is ever inspected. -->
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
