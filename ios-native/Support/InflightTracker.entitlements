<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The container the app and its widgets both read: the pinned flight, the
	     friends list, and the cached aircraft photos the widgets draw on. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tracker.Inflight</string>
	</array>
	<!-- Overridden to "production" by the release export. Notifications are the
	     whole point of the friends list, so a build signed without this is a
	     build where the feature silently does nothing. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple. Required by Guideline 4.8 for any app that offers
	     another third-party sign-in, and the capability has to be on the App ID
	     as well as here or the request fails at runtime with 1000. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal links. What makes a shared inflight.info link open the app
	     rather than Safari: iOS fetches
	     https://inflight.info/.well-known/apple-app-site-association, checks
	     this app's ID is in it, and from then on hands the matching URLs
	     straight here. Both hosts, because people paste both.

	     Two halves, and only one of them is in this repo. Without the file on
	     the site the links still work — they just open the website, which is
	     exactly where they went before — so this is safe to ship ahead of it.
	     Without this entitlement the file achieves nothing. See
	     InflightLink.parse and ContentView's onContinueUserActivity for what
	     happens once a link does arrive. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:inflight.info</string>
		<string>applinks:www.inflight.info</string>
	</array>
</dict>
</plist>
