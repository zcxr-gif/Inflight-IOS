<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Inflight</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Infinite Flight Connect: the sim serves a telemetry socket to whatever
	     is on the same Wi-Fi, so reading your own aircraft means talking to
	     another device on the local network. iOS asks the user once, using
	     this sentence, and refuses every local connection until they agree.
	     Discovery additionally listens for the broadcast Infinite Flight
	     sends on UDP 15000; if Apple's multicast entitlement turns out to be
	     required for that, only discovery is affected — entering the device's
	     address by hand goes through this permission alone. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Inflight connects to Infinite Flight running on another device on your Wi-Fi to read your aircraft and record your landings.</string>
	<!-- The sky view: the camera draws the picture the traffic is laid over.
	     No frame is captured, kept or sent anywhere — the session has a preview
	     layer and no output at all. -->
	<key>NSCameraUsageDescription</key>
	<string>Inflight draws the traffic over what your camera sees. Nothing is recorded or sent anywhere.</string>
	<!-- Also the sky view. Two things need this: where you are standing, which
	     is what the aircraft are placed relative to, and true north — the angle
	     between the magnetic pole and the real one depends on where you are, so
	     CoreMotion will not give a true-north reference frame without it. Read
	     while the view is open and never stored or transmitted. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Inflight uses your location to point the sky view at the traffic and to work out true north. It stays on your phone.</string>
	<!-- The gyroscope and compass behind the same view: which way the phone is
	     pointing is the whole of how an aircraft lands in the right part of the
	     screen. -->
	<key>NSMotionUsageDescription</key>
	<string>Inflight reads the compass and gyroscope to work out which way you are pointing the phone in the sky view.</string>
	<!-- Live Activities: the "live banner" a watched pilot's takeoff raises. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- The backend pushes progress roughly once a minute for the whole of a
	     long-haul, which is well past what iOS budgets for an activity that
	     hasn't declared it. Without this the system quietly starts dropping
	     updates part-way through the flight. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- The static screen iOS shows while the app process starts, before a
	     single SwiftUI view exists. It was empty, which meant white — a white
	     flash in front of a dark app, every launch, before `LaunchVeil` had
	     even been built.

	     The colour, and deliberately not `UIImageName` as well. That key does
	     not draw its image at the image's own size: it aspect-fits it to the
	     whole screen, so a mark sized to match the veil's would arrive as a
	     pin several hundred points across and a different size on every
	     device. The ground is the half that can be matched exactly, so the
	     ground is the half that is matched, and the veil fades its own mark in
	     over the top of it — which reads as the app arriving rather than as a
	     seam. `LaunchBackground` is the midpoint of the veil's gradient and
	     carries a dark appearance of its own. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Deep links from the widgets. `inflight://open?flight=…` and
	     `airport=…` — see InflightLink, which is the only thing that builds or
	     reads these, in either process. Not a claim on a public namespace:
	     nothing else is expected to link to the app, and the scheme exists so
	     a tile can name what it is about. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.tracker.Inflight.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>inflight</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
